# ───────── Frontend (Vite, build-time; public values only) ─────────
# false = talk to the real backend. true = built-in demo data, no backend needed.
VITE_USE_MOCK=true
# Browser served by the backend (single container): use same-origin URLs
#   VITE_API_BASE_URL=/api/v1      VITE_SOCKET_URL=
# Mobile app (Capacitor) or separately hosted UI: use the absolute https URL of your API
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
