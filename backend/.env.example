# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of this API (used to build absolute media URLs)
PUBLIC_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (CORS + Socket.IO). Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5000,https://localhost,capacitor://localhost,http://localhost
# Set to 1 when running behind a reverse proxy / load balancer (so rate limits see the real client IP)
TRUST_PROXY=0

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://smu:change-me@localhost:5432/smu?schema=public

# ── Redis (presence, rate limits, Socket.IO adapter, job locks). Optional in dev: falls back to memory.
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (use different values for each)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# 1 = registration requires the emailed OTP before the first login
REQUIRE_EMAIL_VERIFICATION=0
# Dev only: include the OTP in API responses so you can test without an SMTP server. Never enable in production.
EXPOSE_DEV_OTP=1

# ── Email (OTP / password reset). Leave SMTP_HOST empty to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Send ME/U <no-reply@sendmeu.app>"

# ── Media storage: local | s3 ───────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# S3 (or any S3-compatible service: R2, MinIO, Spaces)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
# Seconds a signed media URL stays valid (private media)
MEDIA_URL_TTL=3600

# ── Push notifications (Expo Push). Optional access token for enhanced security.
EXPO_ACCESS_TOKEN=

# ── WebRTC (served to clients by GET /api/v1/calls/ice-servers) ──
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Admin bootstrap (used by `npm run seed`, creates/updates this admin) ──
ADMIN_EMAIL=admin@sendmeu.app
ADMIN_PASSWORD=ChangeMe!12345

# Run background jobs in this process (set false on extra API replicas if you run a dedicated worker)
RUN_JOBS=true
